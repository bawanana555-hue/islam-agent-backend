const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json({ limit: '50mb' }));

// --- CONFIGURATION DES RÉPERTOIRES ---
const DATA_DIR = path.join(__dirname, 'data');
const VAULT_DIR = path.join(DATA_DIR, 'media_vault'); // Pour vos audios, vidéos, etc.

if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });
if (!fs.existsSync(VAULT_DIR)) fs.mkdirSync(VAULT_DIR, { recursive: true });

// --- CHARGEMENT INITIAL (CORAN) ---
let quranData = null;
try {
    const quranPath = path.join(DATA_DIR, 'quran_fr.json');
    if (fs.existsSync(quranPath)) {
        quranData = JSON.parse(fs.readFileSync(quranPath, 'utf-8'));
        console.log('✅ Base de données Coran prête');
    }
} catch (e) { console.log('⚠️ Erreur lecture Coran JSON'); }

// --- MOTEUR DE RECHERCHE LOCAL ---
function searchLocal(query) {
    const q = query.toLowerCase();
    let results = [];

    // 1. Fouiller dans les fichiers textes (Audio/Vidéo transcrits)
    try {
        const files = fs.readdirSync(VAULT_DIR);
        files.forEach(file => {
            const content = fs.readFileSync(path.join(VAULT_DIR, file), 'utf-8');
            if (content.toLowerCase().includes(q)) {
                results.push({ type: 'media_local', source: file, text: content.substring(0, 300) + '...' });
            }
        });
    } catch (e) { console.log('Erreur scan media_vault'); }

    // 2. Fouiller dans le Coran
    if (quranData && quranData.versets) {
        Object.entries(quranData.versets).forEach(([sId, versets]) => {
            versets.forEach(v => {
                if (v.traduction.toLowerCase().includes(q)) {
                    results.push({ type: 'coran', ref: `Sourate ${sId}:${v.id}`, text: v.traduction });
                }
            });
        });
    }
    return results;
}

// --- ROUTES ---
app.post('/mcp', (req, res) => {
    const { tool, params } = req.body;
    if (tool === 'search_local') {
        const results = searchLocal(params.query || '');
        return res.json({ results });
    }
    res.status(404).json({ error: 'Outil non reconnu' });
});

app.listen(PORT, '0.0.0.0', () => {
    console.log(`🕌 Serveur Islam-Agent lancé sur le port ${PORT}`);
});
